# Copy to .env and fill in. Do NOT commit .env.
# Roboflow Private API Key: https://app.roboflow.com → Settings → Roboflow API
ROBOFLOW_API_KEY=your_roboflow_private_api_key_here

# Upstream dataset coordinates (from the Universe URL)
ROBOFLOW_WORKSPACE=lia-k4jkv
ROBOFLOW_PROJECT=cat-pain-ul7lu
ROBOFLOW_VERSION=1

# Forked binary set (owned workspace; system-of-record for this project)
ROBOFLOW_WORKSPACE_OWNED=mingraths-workspace
ROBOFLOW_PROJECT_FORK=cat-pain-ul7lu-p3rtl

# VLM 5-AU weak-labeler (Gate 1-B). Never paste a real key.
ANTHROPIC_API_KEY=

# W&B runs / sweeps / Artifacts. Never paste a real key.
WANDB_API_KEY=
WANDB_ENTITY=
